# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database (Phase 2: Postgres via Docker Compose — no local db file to track)
prisma/dev.db
prisma/dev.db-journal
*.db
*.db-journal

# husky internal (populated by `npm run prepare`, not source)
.husky/_

# uploads (local driver — src/server/uploads)
.uploads/
.vitest-uploads/

# vitest coverage
coverage/
.vitest-cache/

# production build output (alternate names some tooling expects)
/dist

# prisma generated client (already covered by /node_modules, kept explicit)
.prisma/client

# logs
*.log

# editors / OS
.vscode/settings.json
.idea/

# temp files
tmp/
temp/

# sqlite (alternate extension — see the *.db rule above for the one this repo actually uses)
*.sqlite

# test artifacts (not currently produced by this repo's toolchain, ignored defensively)
playwright-report/
test-results/
.cache/
