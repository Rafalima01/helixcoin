# Copy to .env and fill in. Loaded + validated by src/server/config — the
# app will refuse to boot if a required variable is missing or malformed
# (see src/server/config/env.ts).

# ---- Runtime ----
NODE_ENV="development"
LOG_LEVEL="debug" # debug | info | warn | error | fatal

# ---- Database (PostgreSQL via Docker Compose — see docker-compose.yml) ----
DATABASE_URL="postgresql://helijump:helijump@localhost:5432/helijump"

# ---- Cache / Queue (Redis via Docker Compose) ----
REDIS_URL="redis://localhost:6379"

# ---- Auth (JWT access/refresh — src/modules/identity is the sole auth source) ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-access-secret-change-in-production"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-in-production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ---- Encryption (server/security) ----
# Must decode to exactly 32 bytes. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# ---- CORS (server/security) — comma-separated origins, empty = same-origin only ----
CORS_ALLOWED_ORIGINS=""

# ---- WebSocket server (scripts/ws-server.ts) ----
WS_PORT="3001"

# ---- Object storage (uploads — src/server/uploads). Local disk by default. ----
UPLOADS_DRIVER="local" # local | s3
UPLOADS_LOCAL_DIR="./.uploads"
UPLOADS_S3_BUCKET=""
UPLOADS_S3_REGION=""
UPLOADS_S3_ACCESS_KEY_ID=""
UPLOADS_S3_SECRET_ACCESS_KEY=""

# ---- Observability ----
SENTRY_DSN=""
METRICS_ENABLED="true"

# ---- Feature flags (comma-separated keys — src/server/config/flags.ts) ----
FEATURE_FLAGS=""
