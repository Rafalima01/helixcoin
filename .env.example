# Copy to .env and fill in. Loaded + validated by src/server/config — the
# app will refuse to boot if a required variable is missing or malformed
# (see src/server/config/env.ts).

# ---- Runtime ----
NODE_ENV="development"
LOG_LEVEL="debug" # debug | info | warn | error | fatal

# ---- Database (PostgreSQL via Docker Compose — see docker-compose.yml) ----
DATABASE_URL="postgresql://helijump:helijump@localhost:5432/helijump"

# ---- Cache / Queue (Redis via Docker Compose) ----
REDIS_URL="redis://localhost:6379"

# ---- Auth (JWT access/refresh — src/modules/identity is the sole auth source) ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-access-secret-change-in-production"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-in-production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ---- Encryption (server/security) ----
# Must decode to exactly 32 bytes. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# ---- CORS (server/security) ----
# Comma-separated allowlist of origins allowed to call the API cross-origin.
# Leave empty to use the built-in safe default (src/server/security/cors.ts):
# the three zone origins below (NEXT_PUBLIC_PLAYER_URL/ADMIN_URL/MANAGER_URL)
# and nothing else — never "*". Only set this explicitly if a deployment's
# real zone domains differ from those three vars (e.g. a fourth consumer).
CORS_ALLOWED_ORIGINS=""

# ---- WebSocket server (scripts/ws-server.ts) ----
WS_PORT="3001"

# ---- Object storage (uploads — src/server/uploads). Local disk by default. ----
UPLOADS_DRIVER="local" # local | s3
UPLOADS_LOCAL_DIR="./.uploads"
UPLOADS_S3_BUCKET=""
UPLOADS_S3_REGION=""
UPLOADS_S3_ACCESS_KEY_ID=""
UPLOADS_S3_SECRET_ACCESS_KEY=""

# ---- Push Notifications (src/modules/notifications) ----
# VAPID keypair for the Web Push provider. Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# ---- Observability ----
SENTRY_DSN=""
METRICS_ENABLED="true"

# ---- Feature flags (comma-separated keys — src/server/config/flags.ts) ----
FEATURE_FLAGS=""

# ---- Zone origins (src/config/domains.ts — see AGENTS.md "Fase Deploy: Domínios/Subdomínios/Produção") ----
# Public on purpose (NEXT_PUBLIC_ prefix — just base URLs, never secrets).
# Used to build links that must point at a different zone than the one
# generating them (e.g. the admin builds a manager-invite link, the manager
# builds a player-facing platform link), by both server code and the browser.
# Never hardcode a host anywhere else — import from src/config/domains.ts.
#
# Same 5 variables, different values per environment (set these in the
# hosting provider's per-environment dashboard — Vercel has one set of env
# vars per Environment: Production/Preview/Development; Hostinger/VPS uses
# separate .env files per deploy target). See DEPLOYMENT.md for the full
# per-environment reference table.
#
#   Development (default below): *.localhost — resolves to 127.0.0.1 in
#   every modern browser/OS, no hosts file needed. NEXT_PUBLIC_PLAYER_URL
#   deliberately uses player.localhost, not bare localhost — see the
#   matching comment in .env for why (dev-only Next.js router quirk, no
#   effect on other environments).
#
#   Staging (e.g. a Vercel Preview deployment): point these at that
#   deployment's actual preview hostnames, or a dedicated staging subdomain
#   set (e.g. https://staging.helixcoin.fun / https://admin.staging.helixcoin.fun
#   / https://manager.staging.helixcoin.fun / https://api.staging.helixcoin.fun)
#   if using a persistent staging environment instead of ephemeral previews.
#
#   Production: https://helixcoin.fun / https://admin.helixcoin.fun /
#   https://manager.helixcoin.fun / https://api.helixcoin.fun
NEXT_PUBLIC_PLAYER_URL="http://player.localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://admin.localhost:3000"
NEXT_PUBLIC_MANAGER_URL="http://manager.localhost:3000"
NEXT_PUBLIC_API_URL="http://api.localhost:3000"

# Auth cookie Domain attribute (src/config/domains.ts's COOKIE_DOMAIN doc
# comment has the full rationale). Leave EMPTY in dev/staging (host-only
# cookies — each zone's session stays exclusive to that zone). In
# PRODUCTION set it to ".helixcoin.fun" so a session is visible across all
# three zones — that's what lets src/proxy.ts auto-redirect a wrong-zone
# session on mere navigation, not just after a login attempt. This never
# grants cross-zone access by itself — the middleware's role gate is still
# the actual authorization boundary.
NEXT_PUBLIC_COOKIE_DOMAIN=""
