generator client {
  provider      = "prisma-client-js"
  // "native" for local dev, the musl target for the Alpine-based Docker
  // image (see Dockerfile) — both are generated so `prisma generate` works
  // identically on a dev machine and inside the build container.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Conventions (Phase 2 — backend foundation)
// ============================================================================
// - Primary keys: String @id @default(uuid()) everywhere. No auto-increment
//   ints — avoids leaking row counts/order and matches distributed-system
//   friendly ID generation (safe to generate client-side, before insert).
// - Timestamps: `createdAt` on every append-only/event-like row. Mutable
//   entities also carry `updatedAt @updatedAt`.
// - Soft delete: applied where a real module needs it (User, as of Phase 3).
//   Every query against a soft-deletable model MUST filter `deletedAt: null`
//   explicitly — Prisma has no global default-scope mechanism, so this is a
//   repository-layer discipline (see modules/identity's UserRepository).
// - Money: always integer cents (Int), never Float — see Transaction.amount,
//   Wallet.balance, Match.betAmount/payout.
// ============================================================================

/// Platform-wide game settings, controlled exclusively by the backend/admin.
/// Single row with id "global" — the frontend only ever reads it.
model GameConfig {
  id               String   @id @default("global")
  targetMultiplier Float    @default(5)
  /// Referral commission rates per network depth (admin-configurable).
  commissionLevel1 Float    @default(0.10)
  commissionLevel2 Float    @default(0.05)
  commissionLevel3 Float    @default(0.02)
  updatedAt        DateTime @updatedAt
}

// ============================================================================
// Identity module (Phase 3) — the ONLY source of authentication/authorization
// for the whole platform. See src/modules/identity.
// ============================================================================

enum UserStatus {
  ACTIVE
  PENDING // registered, email not yet verified — still able to log in unless the module enforces otherwise
  BLOCKED // administrative block, indefinite
  SUSPENDED // administrative block, temporary (see User.suspendedUntil)
}

model User {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  username     String    @unique
  email        String    @unique
  phone        String?
  passwordHash String
  avatar       String?
  /// Prepared, not enforced yet — nullable, unique when present.
  cpf          String?   @unique
  dateOfBirth  DateTime?
  locale       String    @default("pt-BR")
  timezone     String    @default("America/Sao_Paulo")

  status UserStatus @default(PENDING)
  role   Role       @default(USER)
  tags   String[]   @default([])

  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  mfaEnabled      Boolean   @default(false)
  loginAttempts   Int       @default(0)
  lockedUntil     DateTime? // temporary lock from repeated failed logins (distinct from status: BLOCKED)
  suspendedUntil  DateTime? // administrative temporary suspension (status: SUSPENDED)

  referralCode String  @unique
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")
  xp           Int     @default(0)
  level        Int     @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — repositories must filter this explicitly

  wallet                  Wallet?
  matches                 Match[]
  transactions            Transaction[]
  achievements            UserAchievement[]
  notifications           Notification[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  mfaMethods              MfaMethod[]
  mfaRecoveryCodes        MfaRecoveryCode[]

  @@index([referredById])
  @@index([status])
  @@index([role])
  @@index([deletedAt])
}

/// Staff/player RBAC roles. `USER` is the default for players; `AFFILIATE`
/// is a player additionally enrolled in the affiliate program. The rest are
/// staff/backoffice roles.
enum Role {
  SUPER_ADMIN
  ADMIN
  FINANCE
  OPERATOR
  MODERATOR
  SUPPORT
  COMPLIANCE
  AUDIT
  USER
  AFFILIATE
}

/// Permission catalog — independent of roles. A role is just a named group
/// of permissions (RolePermission), never a hardcoded check in application
/// code beyond `PermissionService.hasPermission(role, key)`.
model Permission {
  id          String @id @default(uuid())
  /// Stable machine key, e.g. "users.read" — what code checks against.
  key         String @unique
  description String

  roles RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

enum SessionStatus {
  ACTIVE
  REVOKED
}

/// One row per login. Mirrors the Redis-side session created by
/// src/server/auth/tokens.ts (same id) — Redis is the fast-path
/// TTL/rotation store the JWT middleware reads on every request; this table
/// is the durable, queryable record a user's "my devices" screen reads and
/// an admin can audit after the Redis TTL has long expired.
model Session {
  id             String        @id // same value as the JWT `sessionId` claim — not a fresh uuid()
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId       String
  status         SessionStatus @default(ACTIVE)
  ip             String?
  userAgent      String?
  os             String?
  browser        String?
  device         String?
  /// Requires a GeoIP provider — not wired in this phase, stays null.
  location       String?
  rememberMe     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  lastActivityAt DateTime      @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  @@index([userId, status])
  @@index([familyId])
  @@index([expiresAt])
}

/// Token itself is never stored — only its SHA-256 hash (server/security's
/// sha256Hex), so a database read can never leak a usable reset link.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The email being verified — captured at request time so a pending email
  /// change doesn't silently verify whatever address is on the row later.
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum MfaMethodType {
  TOTP // authenticator app
  EMAIL
  SMS
}

/// Structure only — no verification flow is wired yet (feature-flagged off).
/// `secretEncrypted` uses server/security's AES-256-GCM helper when a real
/// TOTP integration lands.
model MfaMethod {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            MfaMethodType
  secretEncrypted String?
  enabled         Boolean       @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())

  @@unique([userId, type])
}

model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  BET
  PAYOUT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model Transaction {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TransactionType
  amount    Int
  status    TransactionStatus @default(COMPLETED)
  method    String?
  pixKey    String?
  matchId   String?
  createdAt DateTime          @default(now())

  @@index([userId, type])
  @@index([createdAt])
}

enum MatchStatus {
  ACTIVE
  CASHED_OUT
  LOST
}

model Match {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  betAmount        Int
  status           MatchStatus @default(ACTIVE)
  platformsPassed  Int         @default(0)
  multiplier       Float       @default(1.0)
  /// Goal multiplier snapshotted from GameConfig at match start. Cashout is
  /// rejected server-side while the current multiplier is below this value.
  targetMultiplier Float       @default(5)
  payout           Int?
  seed             String
  createdAt        DateTime    @default(now())
  resolvedAt       DateTime?

  @@index([userId, status])
  @@index([createdAt])
}

model Achievement {
  id          String            @id @default(uuid())
  key         String            @unique
  title       String
  description String
  icon        String
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ============================================================================
// Backend infrastructure (Phase 2) — AuditService (src/server/audit) is the
// only writer, by convention. Now the identity module's primary consumer:
// login history is a filtered read over this table (action starting with
// "auth."), not a separate model.
// ============================================================================

enum AuditActorType {
  SYSTEM
  USER
  ADMIN
}

/// Immutable audit trail. Append-only by convention — no update/delete path
/// is exposed anywhere in the codebase. Written exclusively through
/// AuditService.record() (src/server/audit/audit.service.ts) so every
/// mutation call site has one obvious place to log from.
model AuditLog {
  id         String         @id @default(uuid())
  actorId    String?
  actorType  AuditActorType
  actorRole  Role?
  action     String
  entityType String
  entityId   String?
  /// State before the change, or null for creations.
  before     Json?
  /// State after the change, or null for deletions.
  after      Json?
  ip         String?
  userAgent  String?
  sessionId  String?
  createdAt  DateTime       @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}
