generator client {
  provider      = "prisma-client-js"
  // "native" for local dev, the musl target for the Alpine-based Docker
  // image (see Dockerfile) — both are generated so `prisma generate` works
  // identically on a dev machine and inside the build container.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Conventions (Phase 2 — backend foundation)
// ============================================================================
// - Primary keys: String @id @default(uuid()) everywhere. No auto-increment
//   ints — avoids leaking row counts/order and matches distributed-system
//   friendly ID generation (safe to generate client-side, before insert).
// - Timestamps: `createdAt` on every append-only/event-like row. Mutable
//   entities also carry `updatedAt @updatedAt`.
// - Soft delete: applied where a real module needs it (User, as of Phase 3).
//   Every query against a soft-deletable model MUST filter `deletedAt: null`
//   explicitly — Prisma has no global default-scope mechanism, so this is a
//   repository-layer discipline (see modules/identity's UserRepository).
// - Money: always integer cents (Int), never Float — see WalletTransaction.
//   amount, Wallet.balance, Match.betAmount/payout.
// ============================================================================

/// Platform-wide game settings, controlled exclusively by the backend/admin.
/// Single row with id "global" — the frontend only ever reads it.
/// NOTE: `targetMultiplier` is superseded by GameEconomyConfig.general as of
/// the game-config module (Phase 4) — kept here only for the still-unrelated
/// affiliate commission fields. Matches no longer read `targetMultiplier`.
model GameConfig {
  id               String   @id @default("global")
  targetMultiplier Float    @default(5)
  /// Referral commission rates per network depth (admin-configurable).
  commissionLevel1 Float    @default(0.10)
  commissionLevel2 Float    @default(0.05)
  commissionLevel3 Float    @default(0.02)
  /// Platform-wide switch — blocks new matches (MatchEngineService.create) without affecting matches already in progress.
  maintenanceMode  Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

// ============================================================================
// Game Engine / RTP Control (Phase 4) — src/modules/game-config is the ONLY
// writer/reader of GameEconomyConfig. See that module's field-registry.ts for
// the catalog of every knob stored inside `general`/`modes`/`antiCheat`.
// ============================================================================

enum GameMode {
  DEMO
  NORMAL
  HARD
}

enum ConfigStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Versioned, mode-scoped economy/physics/anti-cheat configuration. Rows are
/// append-only: activating a draft archives the previous ACTIVE row rather
/// than mutating it, so history (and "restore a previous version") is just a
/// read + clone, never a destructive update.
model GameEconomyConfig {
  id          String       @id @default(uuid())
  version     Int          @unique
  status      ConfigStatus @default(DRAFT)
  /// Admin-entered changelog note for this version.
  description String?

  /// { targetMultiplierDefault, betMin, betMax, quickBetAmounts[] (cents),
  ///   hardModeBalanceThreshold (cents, 0 = disabled),
  ///   goalMultiplierMin/Default/Max, goalAllowFixed, goalAllowDynamic }
  general Json

  /// { DEMO: {...field-registry keys}, NORMAL: {...}, HARD: {...} }
  modes Json

  /// { maxPlatformsPerSecond, minSecondsToGoal, minSecondsBeforeCashout,
  ///   maxVerticalSpeed, maxCollisionsPerSecond }
  /// Older rows may still carry maxHorizontalSpeed/maxAcceleration keys; both
  /// were removed from the panel (unenforceable without trusting client-
  /// reported telemetry) and are simply ignored on read.
  antiCheat Json

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  activatedAt DateTime?

  @@index([status])
}

// ============================================================================
// Identity module (Phase 3) — the ONLY source of authentication/authorization
// for the whole platform. See src/modules/identity.
// ============================================================================

enum UserStatus {
  ACTIVE
  PENDING // registered, email not yet verified — still able to log in unless the module enforces otherwise
  BLOCKED // administrative block, indefinite
  SUSPENDED // administrative block, temporary (see User.suspendedUntil)
}

model User {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  username     String    @unique
  email        String    @unique
  /// The player-facing login identifier since CPF-required signup (phone+senha) — nullable, unique when present.
  phone        String?   @unique
  passwordHash String
  avatar       String?
  /// Prepared, not enforced yet — nullable, unique when present.
  cpf          String?   @unique
  dateOfBirth  DateTime?
  locale       String    @default("pt-BR")
  timezone     String    @default("America/Sao_Paulo")

  status UserStatus @default(PENDING)
  role   Role       @default(USER)
  tags   String[]   @default([])

  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  mfaEnabled      Boolean   @default(false)
  loginAttempts   Int       @default(0)
  lockedUntil     DateTime? // temporary lock from repeated failed logins (distinct from status: BLOCKED)
  suspendedUntil  DateTime? // administrative temporary suspension (status: SUSPENDED)

  referralCode String  @unique
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")
  xp           Int     @default(0)
  level        Int     @default(1)

  /// Phase 8 — which AffiliateLink (campaign-tagged variant of the referrer's
  /// single referralCode) was used at signup, for analytics only. Never used
  /// for attribution — `referredById` above is the one and only relationship
  /// the commission engine walks.
  affiliateLinkId String?
  attributedLink  AffiliateLink? @relation(fields: [affiliateLinkId], references: [id])

  /// Fase Demo — `?source=` query param at signup, analytics only (mirrors
  /// affiliateLinkId's "never used for attribution" rule). `eligibleForFirstDepositBonus`
  /// is the one field promotions.service.ts actually reads to decide whether
  /// to credit a bonus on this user's first confirmed deposit.
  signupSource                 String?
  eligibleForFirstDepositBonus Boolean @default(false)

  /// Conta Demo (influenciadores/parceiros) — criada exclusivamente pelo
  /// backoffice (src/modules/demo-accounts), nunca via cadastro público.
  /// Bloqueada de depósitos/saques/comissões/bônus e excluída de todos os
  /// relatórios financeiros. Sempre criada junto com tags:["demo"], que é o
  /// que o game-config usa para resolver o modo de dificuldade DEMO.
  isDemo Boolean @default(false)

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime? // soft delete — repositories must filter this explicitly
  /// Snapshot of {email,username,phone,cpf} taken right before softDelete()
  /// overwrites those columns with tombstone values — see
  /// UserManagementService.softDelete's doc comment. email/username/phone/cpf
  /// carry plain (non-partial) @unique constraints, so a soft-deleted row
  /// would otherwise hold those values forever, blocking a real person (or a
  /// tester) from ever signing up again with the same CPF/phone/email.
  /// restore() reads this back to bring the original identity back, when
  /// nothing else has claimed it in the meantime.
  deletedIdentitySnapshot Json?

  wallet                     Wallet?
  matches                    Match[]
  transactions               WalletTransaction[]
  createdGameConfigs         GameEconomyConfig[]
  achievements               UserAchievement[]
  notifications              Notification[]
  sessions                   Session[]
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]
  mfaMethods                 MfaMethod[]
  mfaRecoveryCodes           MfaRecoveryCode[]
  deposits                   Deposit[]
  withdraws                  Withdraw[]
  gatewayCredentialsCreated  GatewayCredential[]
  managerProfile             ManagerProfile?
  affiliateProfile           AffiliateProfile?
  commissionsAsOrigin        Commission[]             @relation("CommissionOrigin")
  commissionsAsPayee         Commission[]             @relation("CommissionPayee")
  pixKeys                    PixKey[]
  commercialWithdraws        CommercialWithdraw[]
  commercialWithdrawsDecided CommercialWithdraw[]     @relation("CommercialWithdrawDecider")
  managerInvitesCreated      ManagerInvite[]          @relation("ManagerInviteCreatedBy")
  managerInviteAccepted      ManagerInvite?           @relation("ManagerInviteAcceptedBy")
  managerInvitesRevoked      ManagerInvite[]          @relation("ManagerInviteRevokedBy")
  managerInvitesApproved     ManagerInvite[]          @relation("ManagerInviteApprovedBy")
  managerInvitesRejected     ManagerInvite[]          @relation("ManagerInviteRejectedBy")
  pushSubscriptions          PushSubscription[]
  notificationPreferences    NotificationPreference[]

  @@index([referredById])
  @@index([affiliateLinkId])
  @@index([status])
  @@index([role])
  @@index([isDemo])
  @@index([deletedAt])
}

/// Staff/player RBAC roles. `USER` is the default for players; `AFFILIATE`
/// is a player additionally enrolled in the affiliate program; `MANAGER`
/// (Phase 8) oversees a set of affiliates but has zero financial/platform
/// visibility (no Wallet/Ledger/Gateway access) — see src/modules/manager.
/// The rest are staff/backoffice roles.
enum Role {
  SUPER_ADMIN
  ADMIN
  FINANCE
  OPERATOR
  MODERATOR
  SUPPORT
  COMPLIANCE
  AUDIT
  USER
  AFFILIATE
  MANAGER
}

/// Permission catalog — independent of roles. A role is just a named group
/// of permissions (RolePermission), never a hardcoded check in application
/// code beyond `PermissionService.hasPermission(role, key)`.
model Permission {
  id          String @id @default(uuid())
  /// Stable machine key, e.g. "users.read" — what code checks against.
  key         String @unique
  description String

  roles RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

enum SessionStatus {
  ACTIVE
  REVOKED
}

/// One row per login. Mirrors the Redis-side session created by
/// src/server/auth/tokens.ts (same id) — Redis is the fast-path
/// TTL/rotation store the JWT middleware reads on every request; this table
/// is the durable, queryable record a user's "my devices" screen reads and
/// an admin can audit after the Redis TTL has long expired.
model Session {
  id             String        @id // same value as the JWT `sessionId` claim — not a fresh uuid()
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId       String
  status         SessionStatus @default(ACTIVE)
  ip             String?
  userAgent      String?
  os             String?
  browser        String?
  device         String?
  /// Requires a GeoIP provider — not wired in this phase, stays null.
  location       String?
  rememberMe     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  lastActivityAt DateTime      @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  @@index([userId, status])
  @@index([familyId])
  @@index([expiresAt])
}

/// Token itself is never stored — only its SHA-256 hash (server/security's
/// sha256Hex), so a database read can never leak a usable reset link.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The email being verified — captured at request time so a pending email
  /// change doesn't silently verify whatever address is on the row later.
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum MfaMethodType {
  TOTP // authenticator app
  EMAIL
  SMS
}

/// Structure only — no verification flow is wired yet (feature-flagged off).
/// `secretEncrypted` uses server/security's AES-256-GCM helper when a real
/// TOTP integration lands.
model MfaMethod {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            MfaMethodType
  secretEncrypted String?
  enabled         Boolean       @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())

  @@unique([userId, type])
}

model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============================================================================
// Wallet + Ledger (Phase 6) — src/modules/wallet and src/modules/ledger are
// the ONLY writers of Wallet/WalletTransaction/LedgerEntry. No endpoint or
// other module may mutate a balance directly — every movement goes through
// WalletService (credit/debit/lock/unlock/transfer/refund/adjust/reverse),
// which always produces a matching double-entry LedgerEntry in the same DB
// transaction as the balance change. See those modules' README/service
// files for the account-code convention and idempotency/concurrency design.
// ============================================================================

model Wallet {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Saldo Principal — column name kept as `balance` (not renamed) to avoid
  /// touching every pre-existing read call site; WalletService's public DTO
  /// exposes this as `main`.
  balance       Int @default(0)
  /// Saldo Bloqueado — funds reserved (e.g. a withdrawal in flight) but not
  /// spendable. Moved to/from `balance` exclusively via WalletService.lock/
  /// unlock().
  lockedBalance Int @default(0)
  /// Saldo Bônus — separate bucket, not yet fed by any real flow this phase
  /// (no automatic bonuses implemented), but modeled now so BONUS-type
  /// transactions have somewhere real to land later.
  bonusBalance  Int @default(0)

  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

/// Which of the wallet's 3 buckets a given WalletTransaction moved.
enum WalletAccount {
  MAIN
  LOCKED
  BONUS
}

enum TransactionType {
  BET
  BET_REFUND
  PAYOUT
  DEPOSIT
  DEPOSIT_PENDING
  DEPOSIT_FAILED
  WITHDRAW
  WITHDRAW_PENDING
  WITHDRAW_REJECTED
  WITHDRAW_APPROVED
  BONUS
  CASHBACK
  COMMISSION
  ADJUSTMENT
  REVERSAL
  SYSTEM
  MANUAL
  TRANSFER
  LOCK
  UNLOCK
  EXPIRATION
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

/// One row per wallet-side money movement. Every COMPLETED row that actually
/// changed a balance has a matching LedgerEntry (via `ledgerId`) recording
/// the double-entry pair — see LedgerEntry below. Rows that only register
/// intent (DEPOSIT_PENDING/WITHDRAW_PENDING-as-lock) may have `ledgerId`
/// null only when they genuinely moved no money; anything that touched a
/// balance always has one.
model WalletTransaction {
  id       String @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The double-entry pair for this movement (see LedgerEntry.transactionId
  /// for the reverse pointer — that one is a plain string, not a relation,
  /// to break the creation-order cycle; this FK is the real one, added once
  /// the LedgerEntry already exists).
  ledgerId    String?
  ledgerEntry LedgerEntry? @relation(fields: [ledgerId], references: [id])

  type    TransactionType
  /// Which balance bucket this row moved — see WalletAccount.
  account WalletAccount   @default(MAIN)
  amount  Int

  /// Bucket balance immediately before/after this row, for the `account`
  /// bucket specifically — audit/display only, nullable for historical rows
  /// migrated before this column existed.
  balanceBefore Int?
  balanceAfter  Int?

  /// Where this movement originated — e.g. "match-engine", "wallet-api",
  /// "admin".
  origin   String
  /// Origin-specific correlation id — e.g. a matchId, a pending-deposit id.
  originId String?

  description String?
  status      TransactionStatus @default(COMPLETED)

  /// Caller-supplied idempotency key. Unique when present (Postgres allows
  /// multiple NULLs under a unique index) — replaying the same key always
  /// returns the original row instead of moving money twice.
  idempotencyKey String? @unique

  /// Free-form context — e.g. { method: "PIX", pixKey } for deposits, or
  /// { reason, observation, adminId } for manual adjustments.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([walletId])
  @@index([createdAt])
  @@index([originId])
}

/// Double-entry ledger — append-only. No update/delete path is exposed
/// anywhere in the codebase (LedgerService, src/modules/ledger, only ever
/// exposes read methods). Every real balance movement produces exactly one
/// row here (transfer() produces one row shared by both sides'
/// WalletTransaction rows via their `ledgerId`).
model LedgerEntry {
  id String @id @default(uuid())

  /// The WalletTransaction this entry belongs to. Plain string, not a
  /// Prisma relation: this row is always inserted BEFORE its
  /// WalletTransaction (both ids are pre-generated client-side), so the
  /// referenced row doesn't exist yet at insert time. The real FK lives on
  /// WalletTransaction.ledgerId, pointing back here.
  transactionId String

  /// Logical account codes — see src/modules/ledger/constants for the exact
  /// convention (`WALLET:{userId}:MAIN|LOCKED|BONUS` for player wallets,
  /// fixed system codes like `PLATFORM`/`BONUS_POOL`/`CASHBACK_POOL`/
  /// `COMMISSION_POOL`/`ADJUSTMENT` otherwise). Plain strings rather than a
  /// normalized Account table — deliberately minimal for the flows that are
  /// real this phase.
  debitAccount  String
  creditAccount String

  amount   Int
  /// Plain string, not an enum — BRL only in practice this phase, but no
  /// migration needed when a second currency lands.
  currency String @default("BRL")

  reference     String?
  referenceType String?
  description   String?

  createdAt DateTime @default(now())

  walletTransactions WalletTransaction[]

  @@index([transactionId])
  @@index([debitAccount])
  @@index([creditAccount])
  @@index([createdAt])
}

// ============================================================================
// Payments / Gateway (Phase 7) — src/modules/payments is the ONLY writer of
// GatewayCredential/Deposit/Withdraw/PaymentWebhook/GatewayHealth/GatewayLog/
// PaymentSettings. It never moves a balance itself — every confirmed deposit
// or approved/rejected withdraw calls into WalletService (credit/debit/lock/
// unlock), which is still the sole place a Wallet balance can change. See
// that module's services/payment.service.ts for the settlement/idempotency
// scheme and providers/ for the PaymentProvider abstraction gateways
// implement (only MOCK is functional this phase).
// ============================================================================

enum GatewayProvider {
  MOCK
  CARTPANDA
  CARTWAVEHUB
  MERCADO_PAGO
  PAY4FUN
  BSPAY
  PAY2M
  OPENPIX
  VEOPAG
  AMPLOPAY
  OUTROS
}

enum GatewayMode {
  SANDBOX
  PRODUCTION
}

enum RoutingMode {
  SINGLE
  ROUND_ROBIN
  WEIGHTED
  FAILOVER
}

enum DepositStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  EXPIRED
}

enum WithdrawStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  FAILED
  CANCELLED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  ERROR
  REPROCESSED
}

enum GatewayHealthStatus {
  ONLINE
  DEGRADED
  OFFLINE
}

enum PaymentRelatedType {
  DEPOSIT
  WITHDRAW
}

/// Mock-only test lever (Fase 10) — forces an OUTBOUND provider call
/// (createPixDeposit/getDeposit/createWithdraw/getWithdraw/cancelWithdraw) to
/// fail or hang in a specific way, independent of `simulatedHealth` (which
/// only affects `health()`'s reported status for routing/failover). Lets the
/// admin "Gateways" screen exercise PaymentService's retry/timeout/failover
/// logic on demand without any real network dependency.
enum GatewaySimulatedFault {
  TIMEOUT
  ERROR_500
  AUTH_ERROR
  OFFLINE_CALLS
}

/// One registered gateway configuration. Multiple rows may share the same
/// `provider` (e.g. two MOCK credentials with different `simulatedHealth`,
/// used to exercise failover) — routing picks among `active` rows via
/// PaymentSettings.routingMode. Credentials/webhook secrets are always
/// AES-256-GCM encrypted at rest (src/server/security/crypto-utils) — never
/// stored or logged in plain text.
model GatewayCredential {
  id       String          @id @default(uuid())
  name     String
  provider GatewayProvider
  mode     GatewayMode     @default(SANDBOX)
  active   Boolean         @default(false)

  /// Failover order (lower = tried first) and weighted-routing share.
  priority   Int @default(0)
  weight     Int @default(1)
  timeoutMs  Int @default(15000)
  maxRetries Int @default(2)

  /// AES-256-GCM ("iv:authTag:ciphertext") — provider-specific JSON blob.
  /// For MOCK this is just "{}".
  credentialsEncrypted   String
  /// AES-256-GCM — the HMAC secret used to sign/verify this gateway's
  /// webhooks.
  webhookSecretEncrypted String

  /// Mock-only test lever: forces provider.health() to report this status
  /// regardless of real reachability, so the admin "Gateways" screen and the
  /// failover browser test can force a candidate offline on demand. Null
  /// means "report real health" (always ONLINE for Mock).
  simulatedHealth    GatewayHealthStatus?
  /// Mock-only test lever (Fase 10) — see GatewaySimulatedFault doc comment.
  /// Null means "no simulated fault" (calls succeed normally).
  simulatedErrorMode GatewaySimulatedFault?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deposits           Deposit[]
  withdraws          Withdraw[]
  health             GatewayHealth[]
  logs               GatewayLog[]
  webhooks           PaymentWebhook[]
  defaultForSettings PaymentSettings[]

  @@index([provider])
  @@index([active])
}

/// One PIX deposit charge. `id` is pre-generated client-side
/// (crypto.randomUUID(), before the provider call) — same reasoning as
/// Match.id — so it can be handed to provider.createPixDeposit() and later
/// reused as WalletTransaction.originId once WalletService.credit() runs.
/// PaymentService is the only writer; it never credits the wallet itself
/// until a webhook confirms payment.
model Deposit {
  id String @id

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gatewayCredentialId String
  gatewayCredential   GatewayCredential @relation(fields: [gatewayCredentialId], references: [id])

  amountCents Int
  status      DepositStatus @default(PENDING)

  /// The gateway's own charge id — webhooks key on this to find the row.
  providerTransactionId String?   @unique
  pixCode               String?
  qrCodeUrl             String?
  expiresAt             DateTime?

  /// Set once WalletService.credit() actually runs for this deposit.
  walletTransactionId String?   @unique
  confirmedAt         DateTime?
  failureReason       String?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([gatewayCredentialId])
  @@index([status])
  @@index([createdAt])
}

/// One withdrawal request. Same client-side `id` pre-generation as Deposit.
/// The requested amount is moved to the LOCKED bucket (WalletService.lock())
/// the instant the request is accepted — before the gateway even
/// acknowledges it — and only ever leaves LOCKED via an approve (debit) or
/// reject/failure (unlock), never silently.
model Withdraw {
  id String @id

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gatewayCredentialId String
  gatewayCredential   GatewayCredential @relation(fields: [gatewayCredentialId], references: [id])

  amountCents Int
  status      WithdrawStatus @default(PENDING)

  /// PIX key is personal data — encrypted like gateway credentials.
  pixKeyEncrypted String
  pixKeyType      String?

  providerTransactionId String? @unique

  /// The WalletTransaction that locked the funds at request time.
  lockWalletTransactionId   String? @unique
  /// The WalletTransaction that settled the request (debit on approve, or
  /// null on reject — reject only unlocks, it never creates a settle row).
  settleWalletTransactionId String? @unique

  requestedAt     DateTime  @default(now())
  processedAt     DateTime?
  rejectionReason String?
  failureReason   String?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([gatewayCredentialId])
  @@index([status])
  @@index([createdAt])
}

/// One row per inbound gateway webhook delivery. Points at the Deposit/
/// Withdraw it settles via a discriminated (relatedType, relatedId) pair —
/// same "plain correlation, not a real FK" convention as
/// WalletTransaction.originId — rather than two nullable FK columns.
/// Append-only except for the processing-result fields; a "reprocess" only
/// re-runs settlement, it never rewrites `payload`.
model PaymentWebhook {
  id String @id @default(uuid())

  gatewayCredentialId String
  gatewayCredential   GatewayCredential @relation(fields: [gatewayCredentialId], references: [id])
  /// Denormalized from gatewayCredential.provider for filterable queries
  /// without a join.
  provider            GatewayProvider

  relatedType PaymentRelatedType
  relatedId   String

  /// e.g. "deposit.paid", "withdraw.approved".
  eventType String
  status    WebhookStatus @default(RECEIVED)

  /// The gateway's own event id, when it supplies one — the primary
  /// idempotency key. Falls back to payloadHash when absent.
  providerEventId String? @unique
  /// sha256Hex of the raw request body — fallback dedup key and a tamper
  /// record even when providerEventId is present.
  payloadHash     String
  /// Full raw payload, for the admin viewer and reprocess.
  payload         Json

  responseStatus Int?
  responseBody   Json?
  signatureValid Boolean @default(false)
  errorMessage   String?

  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  reprocessedAt  DateTime?
  reprocessCount Int       @default(0)
  processingMs   Int?

  @@index([gatewayCredentialId])
  @@index([relatedType, relatedId])
  @@index([payloadHash])
  @@index([status])
  @@index([receivedAt])
}

/// Append-only health-check history — one row per check, never mutated.
/// GatewayRouterService reads the latest row per credential (findFirst
/// orderBy checkedAt desc) to decide routing eligibility.
model GatewayHealth {
  id String @id @default(uuid())

  gatewayCredentialId String
  gatewayCredential   GatewayCredential @relation(fields: [gatewayCredentialId], references: [id])

  status    GatewayHealthStatus
  latencyMs Int?
  message   String?
  checkedAt DateTime            @default(now())

  @@index([gatewayCredentialId, checkedAt])
}

/// One row per outbound provider call or inbound webhook — the admin "Logs
/// de Pagamento" screen. `requestSummary`/`responseSummary` are always
/// pre-sanitized at the call site (the logging helper only ever receives a
/// credential's id/provider, never the row itself), so no code path can leak
/// a secret into this table.
model GatewayLog {
  id String @id @default(uuid())

  gatewayCredentialId String?
  gatewayCredential   GatewayCredential? @relation(fields: [gatewayCredentialId], references: [id])
  provider            GatewayProvider?

  /// "outbound" (we called the gateway) or "inbound" (a webhook arrived).
  direction String
  endpoint  String
  method    String?

  requestSummary  Json?
  responseSummary Json?
  statusCode      Int?
  durationMs      Int?
  success         Boolean
  errorMessage    String?

  /// depositId / withdrawId / webhookId — whichever this call relates to.
  correlationId String?

  createdAt DateTime @default(now())

  @@index([gatewayCredentialId])
  @@index([provider])
  @@index([correlationId])
  @@index([createdAt])
  @@index([success])
}

/// Single global row (id "global"), same pattern as GameConfig — the
/// frontend never reads this directly; PaymentService and the admin
/// Gateways screen are its only consumers.
model PaymentSettings {
  id String @id @default("global")

  defaultGatewayCredentialId String?
  defaultGatewayCredential   GatewayCredential? @relation(fields: [defaultGatewayCredentialId], references: [id])
  routingMode                RoutingMode        @default(SINGLE)

  timeoutMs  Int @default(15000)
  maxRetries Int @default(2)

  pixExpirationMinutes Int @default(30)
  depositMinCents      Int @default(500)
  depositMaxCents      Int @default(1000000)
  withdrawMinCents     Int @default(1000)
  withdrawMaxCents     Int @default(1000000)

  maxWebhookProcessingMs Int @default(5000)

  updatedAt DateTime @updatedAt
}

// ============================================================================
// Match Engine (Phase 5) — src/modules/match-engine is the ONLY writer of
// Match/MatchEvent. See that module's utils/match-state-machine.ts for the
// exact allowed transition table between these statuses.
// ============================================================================

enum MatchStatus {
  CREATED
  AWAITING_START
  IN_PROGRESS
  GOAL_REACHED
  CASHOUT_AVAILABLE
  CASHED_OUT
  LOST
  CANCELLED
  INVALIDATED
}

enum MatchEventType {
  CREATED
  STARTED
  PROGRESSED
  GOAL_REACHED
  CASHOUT_REQUESTED
  CASHOUT_APPROVED
  CASHOUT_DENIED
  COMPLETED
  LOST
  CANCELLED
  INVALIDATED
}

model Match {
  id          String @id @default(uuid())
  /// Short, human-shareable, NON-sequential code (see match-number.util.ts) —
  /// deliberately not an incrementing counter, per this schema's own
  /// convention (see the file-level comment) of never leaking row count/order
  /// through an identifier.
  matchNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  betAmount        Int
  status           MatchStatus @default(CREATED)
  platformsPassed  Int         @default(0)
  multiplier       Float       @default(1.0)
  /// Goal multiplier snapshotted from GameEconomyConfig at match start.
  /// Cashout is rejected server-side while the current multiplier is below
  /// this value.
  targetMultiplier Float       @default(5)
  /// betAmount × targetMultiplier at creation time — the cents amount that
  /// unlocks cashout.
  goalAmount       Int
  /// Live estimate of what a cashout right now would pay, updated on every
  /// /progress checkpoint — display-only, the real payout is always
  /// recomputed server-side from platformsPassed at resolve time.
  potentialPayout  Int?
  payout           Int?

  /// Wallet.balance immediately before the bet was debited.
  balanceBefore Int
  /// Wallet.balance immediately after the match resolved (null while active).
  balanceAfter  Int?

  seed String

  /// SHA-256 of the per-match token issued once at creation (same pattern as
  /// PasswordResetToken.tokenHash) — required, alongside auth, on every
  /// begin/progress/resolve call for this match.
  tokenHash String @unique

  /// Difficulty mode resolved for this user at match start (see
  /// GameConfigService.resolveModeForUser).
  mode              GameMode @default(NORMAL)
  /// GameEconomyConfig.version this match was generated from — lets a config
  /// change mid-flight never affect matches already in progress.
  configVersion     Int?
  /// Named DIFFICULTY_PRESET (see src/modules/game-config) the mode profile
  /// matched at creation time, or null if it was already a custom edit.
  presetKey         String?
  /// Exact mode-profile payload (physics + generation params) applied to this
  /// match — the frontend engine's only source of truth, snapshotted so it
  /// stays reproducible/auditable even after the config is later edited.
  engineParams      Json?
  /// Goal-related general config (targetMultiplierDefault, goalMultiplierMin/
  /// Max, betMin/Max) snapshotted alongside engineParams — the full config
  /// context this match was created under, not just physics.
  goalSnapshot      Json?
  /// GameEconomyConfig.antiCheat snapshotted at match start — resolve checks
  /// against this, not whatever is currently active, for the same
  /// reproducibility reason as engineParams.
  antiCheatSnapshot Json?

  startedAt       DateTime?
  resolvedAt      DateTime?
  durationSeconds Int?

  /// Highest number of consecutive platform passes without a losing contact
  /// — defaults to platformsPassed today (a danger contact always ends the
  /// match immediately, so "streak" and "total passed" currently coincide;
  /// kept distinct for when non-fatal mistakes exist).
  longestStreak  Int    @default(0)
  collisionCount Int    @default(0)
  avgSpeed       Float?

  /// 0-100, highest observed/limit ratio across every anti-cheat dimension
  /// checked — populated even when not flagged (see AntiCheatService).
  riskScore          Float   @default(0)
  invalidationReason String?

  engineVersion String?
  ip            String?
  userAgent     String?
  device        String?
  os            String?
  /// Requires a GeoIP provider — not wired in this phase, stays null (same
  /// decision already made for Session.location).
  location      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  events MatchEvent[]

  @@index([userId, status])
  @@index([createdAt])
  @@index([matchNumber])
}

/// Append-only timeline — same spirit as AuditLog, but match-scoped. Never
/// updated or deleted once written; powers both the admin "Timeline da
/// partida" view and the player-facing match history.
model MatchEvent {
  id        String         @id @default(uuid())
  matchId   String
  match     Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type      MatchEventType
  /// Aggregated counters for PROGRESSED checkpoints, denial reasons for
  /// CASHOUT_DENIED, etc. — shape depends on `type`.
  payload   Json?
  createdAt DateTime       @default(now())

  @@index([matchId, createdAt])
}

model Achievement {
  id          String            @id @default(uuid())
  key         String            @unique
  title       String
  description String
  icon        String
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ============================================================================
// Backend infrastructure (Phase 2) — AuditService (src/server/audit) is the
// only writer, by convention. Now the identity module's primary consumer:
// login history is a filtered read over this table (action starting with
// "auth."), not a separate model.
// ============================================================================

enum AuditActorType {
  SYSTEM
  USER
  ADMIN
}

/// Immutable audit trail. Append-only by convention — no update/delete path
/// is exposed anywhere in the codebase. Written exclusively through
/// AuditService.record() (src/server/audit/audit.service.ts) so every
/// mutation call site has one obvious place to log from.
model AuditLog {
  id         String         @id @default(uuid())
  actorId    String?
  actorType  AuditActorType
  actorRole  Role?
  action     String
  entityType String
  entityId   String?
  /// State before the change, or null for creations.
  before     Json?
  /// State after the change, or null for deletions.
  after      Json?
  ip         String?
  userAgent  String?
  sessionId  String?
  createdAt  DateTime       @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

// ============================================================================
// Commercial system — Affiliates + Managers (Phase 8) — src/modules/affiliate
// and src/modules/manager are the ONLY writers of these models. There is no
// second referral tree here: multi-level commission is computed by walking
// the EXISTING User.referredById chain (see Match/Wallet-era conventions
// above) up to 3 hops — these models only add the "is this person an
// approved, paid affiliate" and "who oversees them" layers on top. Every
// commission is a real WalletTransaction (type COMMISSION, reusing the
// SYSTEM_ACCOUNTS.commissionPool mapping reserved since Phase 6) + a real
// LedgerEntry — never a direct balance write. Affiliate withdrawals reuse
// src/modules/payments' existing withdraw flow unmodified.
// ============================================================================

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
  DOCUMENTS_REQUESTED
}

enum AffiliateLinkStatus {
  ACTIVE
  PAUSED
}

enum CommissionSourceType {
  REVSHARE_DEPOSIT
  /// LEGACY — never generated any more. The platform pays commission
  /// exclusively as a percentage of the deposit; flat CPA/FTD bonuses were
  /// removed. The value is retained ONLY because Commission rows created
  /// before that change still carry it: dropping it would break historical
  /// reporting (and Postgres refuses to drop an enum value still in use).
  CPA_FTD
  /// The Gerente's cut of the spread (ceiling - affiliate's override%) on a
  /// level-1 payment, or the full ceiling when the level-1 ancestor is a
  /// Manager with no Affiliate in between — see commission.service.ts.
  MANAGER_SPREAD
}

enum CommissionStatus {
  LOCKED
  AVAILABLE
  REJECTED
}

enum ManagerInviteStatus {
  ACTIVE
  EXPIRED
  REVOKED
  USED
}

enum ManagerProfileStatus {
  ACTIVE
  PENDING
}

/// The Admin's verdict on an accepted-but-not-yet-approved manager
/// application — lives on ManagerInvite rather than a new model or a new
/// UserStatus value (see AGENTS.md's "Refinamento Fase 8" decision F). Null
/// until the invite is accepted.
enum ManagerApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// Admin-issued, single-use onboarding invite — the ONLY way a User becomes
/// a Manager (see ManagerInviteService.accept). tokenHash follows the exact
/// same "never persist the raw secret" convention as PasswordResetToken/
/// EmailVerificationToken: the raw token is returned once, in the create/
/// regenerate response, and is unrecoverable afterward.
model ManagerInvite {
  id    String  @id @default(uuid())
  /// Null until the candidate accepts (see ManagerInviteService.accept) —
  /// the Admin no longer supplies the candidate's identity at creation time,
  /// only generates a bare token/link (see "Cadastro de Gerente" decision).
  name  String?
  email String?
  phone String?
  notes String?

  /// Historical only — the "Refinamento Fase 8" flow (see AGENTS.md) moved
  /// commission/initial-status decisions from invite-creation to approval;
  /// these defaults let new rows omit them while old rows keep their values.
  commissionPercent Float                @default(0)
  initialStatus     ManagerProfileStatus @default(ACTIVE)

  tokenHash String              @unique
  status    ManagerInviteStatus @default(ACTIVE)
  expiresAt DateTime?

  createdById String
  createdBy   User   @relation("ManagerInviteCreatedBy", fields: [createdById], references: [id])

  acceptedAt        DateTime?
  acceptedByUserId  String?   @unique
  acceptedByUser    User?     @relation("ManagerInviteAcceptedBy", fields: [acceptedByUserId], references: [id])
  acceptedIp        String?
  acceptedUserAgent String?

  /// Null until accepted. PENDING_REVIEW feeds the Admin's Solicitações
  /// queue (Comercial → Gerentes → Solicitações) — see ManagerInviteService.
  approvalStatus            ManagerApprovalStatus?
  /// The ceiling decided at approval time — snapshot preserved for audit
  /// history even if ManagerProfile.commissionPercent changes later.
  approvedCommissionPercent Float?
  approvedAt                DateTime?
  approvedById              String?
  approvedBy                User?                  @relation("ManagerInviteApprovedBy", fields: [approvedById], references: [id])
  rejectedAt                DateTime?
  rejectedById              String?
  rejectedBy                User?                  @relation("ManagerInviteRejectedBy", fields: [rejectedById], references: [id])
  rejectionReason           String?

  revokedAt   DateTime?
  revokedById String?
  revokedBy   User?     @relation("ManagerInviteRevokedBy", fields: [revokedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managerProfile ManagerProfile?

  @@index([status])
  @@index([email])
  @@index([approvalStatus])
}

/// One row per Manager — a thin extension of User (role MANAGER), same 1:1
/// pattern as MfaMethod/Session. Managers have zero financial/platform data
/// access; this table only holds oversight/recruitment fields.
model ManagerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Public "become an affiliate under me" invite code — resolved during
  /// affiliate application (see AffiliateProfile.managerId), separate from
  /// and never mixed with the player-referral referralCode mechanism.
  inviteCode String @unique

  /// Set by the Admin at invite time (ManagerInvite.commissionPercent),
  /// editable afterward. Reserved for future network-production commission
  /// calculations — not consumed by any engine yet.
  commissionPercent Float                @default(0)
  /// PENDING blocks /manager portal access until an Admin activates the
  /// account (see manager.service.ts's activateProfile). Independent of
  /// AffiliateProfile.status — Managers are never gated by the affiliate
  /// approval state machine.
  status            ManagerProfileStatus @default(ACTIVE)

  inviteId String?        @unique
  invite   ManagerInvite? @relation(fields: [inviteId], references: [id])

  /// "Meu Link da Plataforma" (/r/{User.referralCode}) hit-count — incremented
  /// by /r/[code]/route.ts when the code resolves to this manager's user.
  platformLinkClicks Int @default(0)
  /// "Convidar Afiliados" (/affiliate-invite/{inviteCode}) hit-count.
  inviteLinkClicks   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affiliates AffiliateProfile[]

  @@index([inviteCode])
  @@index([status])
}

/// One row per Affiliate — a thin extension of User (role AFFILIATE), same
/// 1:1 pattern as ManagerProfile. `status` gates whether the commission
/// engine (src/modules/affiliate/services/commission.service.ts) pays this
/// user anything at all — a User with no AffiliateProfile, or one that's
/// PENDING/REJECTED/BLOCKED, is just a regular player as far as commissions
/// are concerned, even though their referredById chain still exists.
model AffiliateProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  managerId String?
  manager   ManagerProfile? @relation(fields: [managerId], references: [id])

  status AffiliateStatus @default(PENDING)

  /// Free-form document upload metadata (URLs/types) — no file storage
  /// integration built this phase, structure only.
  documentsJson   Json?
  /// AES-256-GCM (src/server/security/crypto-utils), same convention as
  /// Withdraw.pixKeyEncrypted.
  pixKeyEncrypted String?

  /// Per-affiliate override of AffiliateSettings' global default percentage —
  /// null means "use the global percentage".
  revShareOverridePercent Float?

  requestedAt     DateTime  @default(now())
  approvedAt      DateTime?
  approvedById    String?
  rejectionReason String?
  blockedAt       DateTime?
  blockedReason   String?

  /// "Meu Link" (/r/{User.referralCode}) hit-count for this affiliate —
  /// mirrors ManagerProfile.platformLinkClicks, incremented by
  /// /r/[code]/route.ts when the code resolves to an APPROVED affiliate.
  linkClicks          Int     @default(0)
  /// Granted by the owning Manager (or Admin) — lets this affiliate surface
  /// their manager's "Convidar Afiliados" link (ManagerProfile.inviteCode) in
  /// their own panel, recruiting new affiliates under the SAME manager.
  canInviteAffiliates Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links       AffiliateLink[]
  commissions Commission[]

  @@index([managerId])
  @@index([status])
}

/// A named, trackable, pausable/deletable variant of an affiliate's single
/// referralCode — e.g. "campanha-instagram". NEVER a second attribution
/// mechanism: clicking a link's slug still redirects through the exact same
/// referredById-setting signup flow as the plain /r/{referralCode} link,
/// just also tags User.affiliateLinkId for campaign-level analytics.
/// Pausing a link only stops IT specifically from being trackable — the
/// affiliate's core referral code keeps working regardless.
model AffiliateLink {
  id          String           @id @default(uuid())
  affiliateId String
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  name   String
  /// Unique across the whole platform — used as the `?l=` query value.
  slug   String              @unique
  status AffiliateLinkStatus @default(ACTIVE)
  clicks Int                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributedUsers User[]

  @@index([affiliateId])
}

/// One row per commission event per level — the persisted, auditable record
/// behind every WalletTransaction(type COMMISSION) the commission engine
/// creates. `walletTransactionId` is the credit() that moved the money into
/// the affiliate's LOCKED bucket; `unlockWalletTransactionId` is the later
/// unlock() (auto or admin-approved) that moved it LOCKED -> MAIN.
model Commission {
  id          String            @id @default(uuid())
  /// Null for a MANAGER_SPREAD row paid on the manager's own platform link
  /// (link 1) — there's no affiliate in that path. Every other sourceType
  /// still has one.
  affiliateId String?
  affiliate   AffiliateProfile? @relation(fields: [affiliateId], references: [id])

  /// Snapshotted at generation time — the affiliate's manager may change
  /// later without rewriting history.
  managerId String?

  /// Who the wallet credit actually went to — the affiliate on REVSHARE_DEPOSIT/
  /// CPA_FTD rows, or the manager on MANAGER_SPREAD rows. Avoids re-deriving
  /// via the (now-optional) affiliate join on every read.
  payeeUserId String
  payeeUser   User   @relation("CommissionPayee", fields: [payeeUserId], references: [id])

  /// Tree-hop distance from the depositing player up to this affiliate: 1,
  /// 2, or 3. Non-affiliate ancestors in between don't break the count —
  /// see commission.service.ts's tree-walk doc comment.
  level Int

  originUserId String
  originUser   User   @relation("CommissionOrigin", fields: [originUserId], references: [id])

  sourceType CommissionSourceType
  /// The triggering Deposit.id.
  triggerId  String

  amountCents    Int
  /// The percentage actually applied — null for CPA_FTD (a flat amount).
  percentApplied Float?

  status                    CommissionStatus @default(LOCKED)
  walletTransactionId       String?          @unique
  unlockWalletTransactionId String?          @unique

  createdAt       DateTime  @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  @@index([affiliateId, status])
  @@index([originUserId])
  @@index([triggerId])
  @@index([payeeUserId])
  /// Backs ManagerService.getDashboard's sumAmountCents({managerId}) and
  /// getNetworkWithStats's getNetworkAggregates({managerId}) groupBy — both
  /// filter by managerId alone, which had no covering index before this.
  @@index([managerId])
}

/// Single global row (id "global"), same pattern as GameConfig/
/// PaymentSettings. Admin-configurable via /api/admin/affiliate/settings.
model AffiliateSettings {
  id String @id @default("global")

  revShareLevel1Percent Float @default(0.05)
  revShareLevel2Percent Float @default(0.02)
  revShareLevel3Percent Float @default(0.01)

  /// When true (default), a generated commission is unlocked (LOCKED ->
  /// AVAILABLE) immediately. When false, it stays LOCKED until an admin
  /// calls POST /api/admin/affiliate/commissions/{id}/approve.
  autoApproveCommissions              Boolean @default(true)
  /// When true, an affiliate application must be approved by its assigned
  /// Manager (in addition to/instead of Admin) before becoming APPROVED.
  requireManagerApprovalForAffiliates Boolean @default(false)

  updatedAt DateTime @updatedAt
}

// ============================================================================
// Commercial Withdrawals — Affiliates + Managers (Fase X) — src/modules/
// commercial-withdrawals is the ONLY writer of PixKey/CommercialWithdraw.
// Symmetric, always admin-approved (never automatic) withdrawal flow for
// Affiliate/Manager commission balances, with reusable saved PIX keys —
// completely separate from src/modules/payments' player-facing Withdraw
// flow (Deposit/Withdraw/GatewayCredential), which stays untouched. Every
// balance movement still goes exclusively through WalletService (lock/
// unlock/debit) — this module never writes a Wallet balance directly.
// ============================================================================

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  RANDOM
}

/// A reusable, saved PIX destination — an Affiliate/Manager picks one of
/// these (or adds a new one) each time they request a commercial withdrawal,
/// instead of retyping a key every time (contrast src/modules/payments'
/// Withdraw, which stores the key inline per-request with no reuse).
model PixKey {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type         PixKeyType
  keyEncrypted String
  holderCpf    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commercialWithdraws CommercialWithdraw[]

  @@index([userId])
}

enum CommercialWithdrawPayeeRole {
  AFFILIATE
  MANAGER
}

enum CommercialWithdrawStatus {
  PENDING
  APPROVED
  REJECTED
  /// Reserved for a future self-service cancel action — no CANCEL
  /// endpoint/UI exists this pass (only Approve/Reject were requested, see
  /// commercial-withdraw.service.ts). Same "modeled but inert" convention as
  /// e.g. GatewaySimulatedFault's unused variants before Fase 10 wired them.
  CANCELLED
}

/// One commercial withdrawal request — an Affiliate/Manager cashing out
/// their commission balance. Always admin-approved, never automatic (see
/// CommercialWithdrawService.decide) — deliberately distinct from
/// src/modules/payments' Withdraw, which goes through a real payment
/// gateway. Funds move to LOCKED at request time (WalletService.lock),
/// exactly like a player Withdraw, and only ever leave LOCKED via an admin
/// approve (debit) or reject (unlock) — see the service's CAS-based decide().
model CommercialWithdraw {
  id        String                      @id @default(uuid())
  userId    String
  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  payeeRole CommercialWithdrawPayeeRole

  amountCents Int
  status      CommercialWithdrawStatus @default(PENDING)

  /// Null if the source PixKey was later deleted — the request itself still
  /// carries its own encrypted snapshot below, so history is never lost.
  pixKeyId        String?
  pixKey          PixKey?    @relation(fields: [pixKeyId], references: [id], onDelete: SetNull)
  pixKeyType      PixKeyType
  pixKeyEncrypted String
  holderCpf       String

  /// The WalletService.lock() transaction created at request time.
  lockWalletTransactionId   String? @unique
  /// The WalletService.debit()/unlock() transaction created at decide() time.
  settleWalletTransactionId String? @unique

  rejectionReason String?
  decidedByUserId String?
  decidedByUser   User?   @relation("CommercialWithdrawDecider", fields: [decidedByUserId], references: [id])

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@index([payeeRole, status])
  @@index([status])
  @@index([createdAt])
}

/// Single global row (id "global"), same pattern as AffiliateSettings.
/// Admin-configurable via /api/admin/promotions/settings.
model PromotionSettings {
  id String @id @default("global")

  /// Credited automatically on a user's first confirmed deposit, only when
  /// User.eligibleForFirstDepositBonus is true (set at signup via ?source=demo).
  /// Fraction, not percent (0.5 = 50%). 0 = disabled.
  firstDepositBonusPercent Float @default(0.5)

  /// Shown as marketing copy on the Deposit screen ("Garanta X% de bônus a
  /// partir do segundo depósito"). Fraction, not percent (0.2 = 20%). 0 hides
  /// the line entirely. This phase only surfaces the configured percentage in
  /// the UI — it does not credit anything automatically (unlike
  /// firstDepositBonusPercent, which has a real crediting trigger wired in
  /// PromotionsService); wiring an actual second-deposit credit is a
  /// follow-up, not part of this change.
  secondDepositBonusPercent Float @default(0.2)

  /// Countdown banner on the Deposit screen. false = timer never renders.
  depositPromoEnabled         Boolean @default(true)
  /// Timer duration in seconds — never hardcoded in the frontend. Anchored
  /// client-side per browser session (see useDepositPromoCountdown): the
  /// deadline is computed once and persisted, so it never resets just from
  /// navigating within the app — only when it actually expires or this value
  /// changes.
  depositPromoDurationSeconds Int     @default(300)

  /// Quick-amount buttons on the Deposit screen — same concept as
  /// GameEconomyConfig.general.quickBetAmounts (admin-configurable,
  /// array order = display order), but each entry also carries enabled/
  /// highlight metadata, so it's an array of objects instead of plain
  /// numbers. Cents. Shape:
  /// [{ amountCents: number, enabled: boolean, highlightEnabled: boolean, highlightLabel: string | null }]
  /// Null/empty falls back to DEFAULT_DEPOSIT_QUICK_AMOUNTS in application code.
  depositQuickAmounts Json?

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Push Notifications (Fase X) — src/modules/notifications. Generic per-User,
// never role-restricted at the schema level: this phase only wires up
// SUPER_ADMIN/ADMIN (broadcast) and MANAGER (own-network events) audiences,
// but nothing here stops a future phase from also enabling AFFILIATE/USER
// rows without a migration.
// ---------------------------------------------------------------------------

enum PushSubscriptionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

/// One browser/device push registration. `deviceId` is client-generated
/// (crypto.randomUUID(), persisted in localStorage) so the same browser
/// re-subscribing upserts the same row instead of duplicating — this is what
/// "um usuário pode ter vários dispositivos" means in practice: one row per
/// [userId, deviceId], never per userId alone.
model PushSubscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String
  browser  String?
  os       String?

  /// The three pieces the Web Push protocol needs — endpoint is the push
  /// service URL, p256dh/auth are the subscription's encryption keys.
  /// Never logged/exposed once stored (mirrors GatewayCredential's secret
  /// handling conventions).
  endpoint String @unique
  p256dh   String
  auth     String

  status PushSubscriptionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs PushNotificationLog[]

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([status])
}

/// One category the push system knows how to send. Deliberately a single
/// flat enum (not split per-role) — the audience for a category is decided
/// in code (NotificationDispatcher), not in the schema, so adding a new
/// audience for an existing category is a code change, never a migration.
enum NotificationCategory {
  DEPOSIT_CONFIRMED
  WITHDRAW_REQUESTED
  WITHDRAW_APPROVED
  WITHDRAW_REJECTED
  MANAGER_REQUESTED
  AFFILIATE_REQUESTED
  DAILY_SUMMARY
  SYSTEM_CRITICAL_ALERT
  MANAGER_NETWORK_DEPOSIT_CONFIRMED
  MANAGER_NETWORK_AFFILIATE_REQUESTED
  TEST
}

/// Per-user, per-category opt-out. Absence of a row means "enabled" (the
/// default) — a row only ever needs to exist once someone actually toggles
/// something off, same "sparse override" pattern as AffiliateProfile's
/// cpaOverrideCents/revShareOverridePercent.
model NotificationPreference {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category NotificationCategory
  enabled  Boolean              @default(true)

  updatedAt DateTime @updatedAt

  @@unique([userId, category])
}

enum PushDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  CLICKED
}

/// One row per push attempt per device — "Salvar todo push enviado" from the
/// spec. DELIVERED/CLICKED are filled in later by beacons the Service Worker
/// fires from its own `push`/`notificationclick` handlers (Web Push has no
/// server-side delivery ack), never assumed at send time.
model PushNotificationLog {
  id String @id @default(uuid())

  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// Denormalized from subscription.userId — lets admin history be queried
  /// without a join, same convention as PaymentWebhook.provider.
  userId         String

  category NotificationCategory
  title    String
  body     String
  deepLink String?

  status       PushDeliveryStatus @default(QUEUED)
  errorMessage String?

  sentAt      DateTime?
  deliveredAt DateTime?
  clickedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}
